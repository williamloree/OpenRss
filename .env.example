# Umami Analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here

# Jeton pour déclencher une vérification push manuelle (POST /api/push/check)
# Header : Authorization: Bearer <ADMIN_TOKEN>. Vide = route désactivée.
ADMIN_TOKEN=

# Autoriser les flux RSS / webhooks n8n sur le réseau local (localhost, 192.168.x.x...)
# Laisser à false sur une instance publique (protection SSRF).
ALLOW_PRIVATE_URLS=false

# Notifications push (optionnel : générées et stockées dans data/ si absentes)
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Fréquence de vérification des nouveaux articles, en minutes
PUSH_CHECK_INTERVAL_MINUTES=15

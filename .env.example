# Umami Analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here

# Jeton requis pour modifier la bibliothèque de flux (POST/PUT/DELETE /api/feeds-library)
# Header : Authorization: Bearer <ADMIN_TOKEN>. Vide = modification désactivée.
ADMIN_TOKEN=

# Autoriser les flux RSS / webhooks n8n sur le réseau local (localhost, 192.168.x.x...)
# Laisser à false sur une instance publique (protection SSRF).
ALLOW_PRIVATE_URLS=false
